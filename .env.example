# AMLGuard Azure development configuration
#
# Copy this file to `.env` and replace placeholder values locally.
# The real `.env` file is ignored by Git and must never be committed.

AZURE_SUBSCRIPTION_ID=<your-subscription-id>
AZURE_TENANT_ID=<your-tenant-id>
AZURE_RESOURCE_GROUP=rg-amlguard-dev-brazilsouth
AZURE_ML_WORKSPACE=mlw-amlguard-dev
AZURE_LOCATION=brazilsouth
AZURE_ENVIRONMENT=dev
AZURE_AUTH_MODE=azure_cli

# Local development uses the authenticated Azure CLI session (`az login`).
# Never store passwords, access keys, tokens, or client secrets here.
